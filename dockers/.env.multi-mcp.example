# Multi-MCP Server Configuration
# Copy this file to .env and fill in your credentials

# Project Name (used as container prefix)
COMPOSE_PROJECT_NAME=multi-mcp

# ============================================================================
# GitHub MCP Server Configuration
# ============================================================================
# Get your token from: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user
GITHUB_PERSONAL_ACCESS_TOKEN=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

# ============================================================================
# Kibana MCP Server Configuration
# ============================================================================
# Your Kibana server URL (for UI access)
KIBANA_URL=https://my-observability-project-e7d823.kb.us-central1.gcp.elastic.cloud/

# Elasticsearch URL (for direct API queries - REQUIRED for Elastic Cloud)
# Replace .kb. with .es. in your Kibana URL
ELASTICSEARCH_URL=https://my-observability-project-e7d823.es.us-central1.gcp.elastic.cloud

# Authentication Method 1: Basic Authentication (Username/Password)
#KIBANA_USERNAME=your-kibana-username
# KIBANA_PASSWORD=your-kibana-password

# Authentication Method 2: API Key (alternative to username/password)
KIBANA_API_KEY=WmpmMXRab0J0VDg5VTRmOFlHWFc6N2h3TmRyVEF6cWc2SE9vVmYwZ0VZZw==
KIBANA_EXTRA_HEADERS={"kbn-xsrf":"true"}

# Authentication Method 3: Cookie Authentication (alternative)
# KIBANA_COOKIES=sid=your-session-id; security-session=your-security-session

# Optional: Kibana Space (default: "default")
KIBANA_DEFAULT_SPACE=default

# Optional: Skip TLS verification (for self-signed certificates)
NODE_TLS_REJECT_UNAUTHORIZED=0

# ============================================================================
# Notes:
# - Choose ONE authentication method for Kibana (username/password, API key, or cookies)
# - Comment out unused authentication variables
# - Keep this file secure and never commit it to version control
# ============================================================================
